generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  DRAFT
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum Gender {
  L
  P
}

model Category {
  id        String   @id @default(cuid())
  name      String
  price     Int
  quota     Int
  saleStart DateTime
  saleEnd   DateTime
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String      @id // format KWR-{tahun}-{6 acak}; kode tiket = {id}-{urutan peserta}
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  status      OrderStatus @default(DRAFT)
  subtotal    Int
  discount    Int         @default(0)
  fee         Int         @default(0)
  total       Int
  promoCode   String?
  paymentMethod String? // qris, bca_va, gopay, dst. dipilih di langkah 4 sebelum Snap dibuka
  snapToken   String? // token Snap pertama; dipakai ulang karena Midtrans menolak order_id yang sama setelah metode dipilih
  snapRedirectUrl String?
  buyerEmail  String
  buyerPhone  String
  expiresAt   DateTime?
  paidAt      DateTime?
  quantity    Int         @default(1) // jumlah tiket dalam satu pembelian
  isTest      Boolean  @default(false) // data uji sistem: tetap disimpan, tidak ikut dihitung di statistik, kuota, dan pendapatan
  uniqueCode  Int         @default(0) // kode unik 3 digit di akhir nominal (bayar manual QRIS)
  waNotifiedAt    DateTime? // bot WA sudah mengirim tautan tiket ke pemesan
  adminNotifiedAt DateTime? // superadmin sudah dikabari lewat Telegram
  participants Participant[]
  payments    Payment[]
  proofs      PaymentProof[]
  tickets     Ticket[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([buyerEmail])
}

model Participant {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id])
  orderId        String
  position       Int      @default(1) // urutan peserta dalam order; peserta 1 = pemesan
  ticket         Ticket?
  fullName       String
  // Kolom tambahan form 24 Sep 2026; nullable supaya aman untuk baris lama (form mewajibkan semuanya kecuali nama belakang).
  firstName      String?
  lastName       String?
  idNumber       String?  // NIK di KTP atau KIA, dipakai untuk verifikasi saat ambil race pack
  address        String?
  province       String?
  city           String?
  postalCode     String?
  bloodType      String?
  birthDate      DateTime
  gender         Gender
  phone          String
  email          String
  jerseySize     String
  emergencyName  String
  emergencyPhone String
  community      String?
  createdAt      DateTime @default(now())

  @@unique([orderId, position])
  @@index([idNumber])
}

model Payment {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  gateway    String // "midtrans", "midtrans-sandbox", "qris-manual", "mock"
  gatewayRef String? // transaction_id dari Midtrans
  method     String // qris, bca_va, gopay, dst.
  amount     Int
  rawPayload Json
  receivedAt DateTime @default(now())

  @@index([orderId])
}

// Bukti bayar QRIS manual yang dikirim pemesan ke WhatsApp; disimpan bot WA supaya bisa dilihat dan diunduh di admin.
model PaymentProof {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  fileName  String
  mimeType  String
  data      Bytes
  source    String   @default("whatsapp")
  createdAt DateTime @default(now())

  @@index([orderId])
}

model Ticket {
  id                 String    @id @default(cuid())
  order              Order     @relation(fields: [orderId], references: [id])
  orderId            String
  participant        Participant? @relation(fields: [participantId], references: [id])
  participantId      String?   @unique
  code               String    @unique
  bibNumber          String?   @unique
  qrSvg              String
  racepackCollectedAt DateTime?
  collectedBy        String?
  createdAt          DateTime  @default(now())

  @@index([orderId])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  discountType String // "percent" | "fixed"
  discountValue Int
  quota        Int
  usedCount    Int       @default(0)
  validFrom    DateTime
  validUntil   DateTime
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Akun halaman admin (/admin). Dibuat lewat `npm run admin:user`, kata sandi diatur sendiri lewat link sekali pakai.
model AdminUser {
  id             String    @id @default(cuid())
  username       String    @unique
  role           String // "superadmin" (semua fitur) | "admin" (keuangan) | "petugas" (reg ulang race pack)
  passwordHash   String?
  setupTokenHash String?   @unique
  setupExpires   DateTime?
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  sessionVersion Int       @default(0) // dinaikkan untuk mengeluarkan semua sesi lama
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
}

// Jejak aksi admin (login, ekspor, verifikasi Midtrans, race pack).
model AdminLog {
  id        String   @id @default(cuid())
  username  String
  action    String
  target    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Pembatas laju per IP (lihat src/lib/rate-limit.ts). Satu baris per kunci "<ember>:<ip>".
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
