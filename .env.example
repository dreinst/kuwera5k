# Akun aplikasi (hak terbatas). Jangan tambahkan sslmode di URL ini; TLS diatur lewat DB_SSL_CA.
DATABASE_URL="postgresql://kuwera_app:password@host:port/kuwera5k"
# Sertifikat CA server database (PEM, boleh ditulis satu baris dengan \n). Kosong = tanpa TLS (hanya untuk lokal).
DB_SSL_CA=""
# Nama di sertifikat server database, diisi kalau DATABASE_URL memakai IP (dari Vercel). Kosong kalau host = nama itu.
DB_SSL_SERVERNAME=""
# Khusus prisma db push: akun pemilik skema, TLS lewat parameter URL.
DATABASE_URL_MIGRASI="postgresql://kuwera_owner:password@host:port/kuwera5k?sslmode=require&sslaccept=accept_invalid_certs"
# mock = tombol simulasi bayar (pratinjau), off = pembayaran belum aktif, midtrans = Snap asli
PAYMENT_MODE="mock"
# Midtrans: kunci Sandbox dan Production sama-sama berawalan Mid-... di dashboard baru;
# bedakan dari dashboard tempat mengambilnya (dashboard.sandbox.midtrans.com vs dashboard.midtrans.com).
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Kunci production disimpan terpisah, dipindah ke MIDTRANS_SERVER_KEY saat go-live
MIDTRANS_PROD_SERVER_KEY=""
MIDTRANS_PROD_CLIENT_KEY=""
# Cloudflare Turnstile (captcha "bukan robot" di form daftar). Isi keduanya dari dashboard Cloudflare > Turnstile;
# kalau salah satu kosong, pemeriksaan dilewati.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Meta Pixel (iklan Facebook/Instagram), angka saja. Kosong = Pixel tidak dimuat.
# Biarkan "Automatic Advanced Matching" nonaktif di Events Manager supaya isi formulir tidak ikut terkirim
# (sesuai kebijakan privasi di /privasi).
NEXT_PUBLIC_META_PIXEL_ID=""
# Kode verifikasi domain dari Meta Business Suite (meta tag facebook-domain-verification). Opsional.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=""
# Kode verifikasi Google Search Console (Settings > Ownership verification > HTML tag, isi atribut content saja). Opsional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Opsional: alamat publik situs kalau berbeda dari domain produksi Vercel, lengkap dengan https://
# (contoh: https://kuwera5k.id).
NEXT_PUBLIC_SITE_URL=""
