DATABASE_URL="postgresql://user:password@localhost:5432/kuwera5k?sslmode=disable"
# mock = tombol simulasi bayar (pratinjau), off = pembayaran belum aktif, midtrans = Snap asli
PAYMENT_MODE="mock"
# Midtrans: kunci Sandbox dan Production sama-sama berawalan Mid-... di dashboard baru;
# bedakan dari dashboard tempat mengambilnya (dashboard.sandbox.midtrans.com vs dashboard.midtrans.com).
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Kunci production disimpan terpisah, dipindah ke MIDTRANS_SERVER_KEY saat go-live
MIDTRANS_PROD_SERVER_KEY=""
MIDTRANS_PROD_CLIENT_KEY=""
